APP_NAME="List Maker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# 本番は LOG_LEVEL=info（spec 8.8 の記録が info のため。warning にすると作成・問い合わせの記録が残らない）
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SOCKET=
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# YouTube Data API v3 key (secret; leave empty here)
YOUTUBE_API_KEY=
# Google OAuth (secrets; leave empty here)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

QUOTA_WRITE_LIMIT=5000
QUOTA_READ_BUDGET=2000
QUOTA_GOOGLE_DAILY=10000

CHANNEL_FETCH_MAX_VIDEOS=1000
CHANNEL_CACHE_REUSE_MINUTES=360
CHANNEL_SYNC_KNOWN_RUN=3

DATA_RETENTION_DAYS=30
CAPTCHA_ENABLED=false
CONTACT_TO_ADDRESS=
# 問い合わせフォームが使えないときの削除依頼の窓口として /contact・/privacy に表示する公開の連絡先（公開してよいものだけ）。空なら「運営者の連絡先（README で設定）」と表示
OPERATOR_CONTACT=
# 信頼するリバースプロキシ（カンマ区切りの IP/CIDR）。空なら信頼しない（#7 の確認後に設定）
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
